{
  "name": "custom-document-pip",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.extension.config.ts && vite build --config vite.videojs.config.ts && vite build --config vite.worker.config.ts",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tsconfig/svelte": "^5.0.4",
    "@types/chrome": "^0.0.308",
    "@types/node": "^24.3.0",
    "eslint": "^9.33.0",
    "eslint-plugin-svelte": "^3.11.0",
    "globals": "^16.3.0",
    "lucide": "^0.468.0",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte": "^5.38.6",
    "svelte-check": "^4.3.1",
    "typescript-eslint": "^8.41.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@videojs/html": "^10.0.0-beta.32",
    "hls.js": "^1.6.15"
  }
}
